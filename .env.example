APP_ENV=development
SERVER_ADDRESS=:8080
DB_ADDR=postgres://urlshortener:secret@localhost:5430/urlshortener?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFE_TIME=5m
LOG_LEVEL=info
LOG_FORMAT=text
SHORTCODE_LENGTH=8
MAX_URL_LENGTH=2048
POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=secret